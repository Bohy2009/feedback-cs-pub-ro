#!/bin/bash

# Generate summary CSV files from processed evaluation data
#
# Usage:
#   ./all-extract <top-folder>

set -e

if [ "$#" -ne 1 ]; then
    echo "Usage: $0 <top-folder>" >&2
    exit 1
fi

top="$1"

if [ ! -d "$top" ]; then
    echo "Error: Folder '$top' does not exist or is not a directory." >&2
    exit 1
fi

# Generate average CSV summaries for a processed dataset.
generate_averages() {
    local input="$1"
    local output="$2"

    ./extract_average "$input/entire/" > "$output/entire.csv"
    ./extract_average "$input/per-semester/" > "$output/per-semester.csv"
    ./extract_average "$input/per-series/" > "$output/per-series.csv"
    ./extract_average "$input/common/" > "$output/common.csv"
    ./extract_average "$input/raw/" > "$output/raw.csv"
}

# Extract professor and assistant sections from the combined CSV.
extract_staff() {
    local csv="$1"
    local output="$2"

    sed -n '/^"Titulari Curs"/,/^"Total:"/p' "$csv" \
        | tail -n +2 \
        | head -n -1 \
        > "$output/prof.csv"

    sed -n '/^"Asisten/,/^"Total:"/p' "$csv" \
        | tail -n +2 \
        | head -n -1 \
        > "$output/asist.csv"
}

# Build per-course professor and assistant summaries.
extract_course_staff() {
    local raw_dir="$1"
    local output="$2"

    > "$output/prof_courses.csv"
    > "$output/asist_courses.csv"

    for file in "$raw_dir"/*.csv; do
        course=$(basename "$file" .csv)

        sed -n '/^"Titulari Curs"/,/^"Total:"/p' "$file" \
            | tail -n +2 \
            | head -n -1 \
            | sed "s/^/\"$course\",/" \
            >> "$output/prof_courses.csv"

        sed -n '/^"Asisten/,/^"Total:"/p' "$file" \
            | tail -n +2 \
            | head -n -1 \
            | sed "s/^/\"$course\",/" \
            >> "$output/asist_courses.csv"
    done
}

process_dataset() {
    local input="$1"
    local output="$2"

    generate_averages "$input" "$output"
    extract_staff "$input/entire/all.csv" "$output"
    extract_course_staff "$input/raw" "$output"
}

process_dataset "$top/processed" "$top/summary"
process_dataset "$top/sep-processed/cti" "$top/summary/cti"
process_dataset "$top/sep-processed/is" "$top/summary/is"
