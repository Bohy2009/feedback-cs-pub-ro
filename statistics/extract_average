#!/bin/bash

# Extract the "Mediu" (Average) row from each processed CSV
#
# Usage:
#   ./extract_average <csv-processed-folder>

set -e

if [ "$#" -ne 1 ]; then
    echo "Usage: $0 <csv-processed-folder>" >&2
    exit 1
fi

input_dir="$1"

if [ ! -d "$input_dir" ]; then
    echo "Error: '$input_dir' is not a directory." >&2
    exit 1
fi

grep 'Mediu' "$input_dir"/*.csv \
    | sed 's|^.*/\(.*\)\.csv:"Mediu"|"\\1"|'
