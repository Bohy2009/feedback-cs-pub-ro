#!/bin/bash

# -----------------------------------------------------------------------------
# all-summarize
#
# Runs all summary generation scripts for every dataset contained in the
# specified project directory.
#
# Usage:
#   ./all-summarize <top-folder>
#
# Generated files:
#   per_series.csv
#   per_semester.csv
#   common.csv
#   prof.csv
# -----------------------------------------------------------------------------

set -e

# Validate arguments.
if [ "$#" -ne 1 ]; then
    echo "Usage: $0 <top-folder>" >&2
    exit 1
fi

TOP="$1"

# Ensure the supplied directory exists.
if [ ! -d "$TOP" ]; then
    echo "Error: '$TOP' does not exist or is not a directory." >&2
    exit 1
fi

# List of datasets to summarize.
DATASETS=(
    "mapping"
    "mapping/cti"
    "mapping/is"
)

# Generate every summary for each dataset.
for dataset in "${DATASETS[@]}"; do
    INPUT="$TOP/$dataset/num_feedbacks/raw.csv"
    OUTPUT_DIR="$TOP/$dataset/num_feedbacks"

    if [ ! -f "$INPUT" ]; then
        echo "Warning: missing input '$INPUT'; skipping '$dataset'." >&2
        continue
    fi
    ./summarize_per_series.py "$INPUT" \
        > "$OUTPUT_DIR/per_series.csv"

    ./summarize_per_semester.py "$INPUT" \
        > "$OUTPUT_DIR/per_semester.csv"

    ./summarize_common.py "$INPUT" \
        > "$OUTPUT_DIR/common.csv"

    ./summarize_prof.py "$INPUT" \
        > "$OUTPUT_DIR/prof.csv"
done
