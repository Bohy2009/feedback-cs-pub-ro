#!/bin/bash

# Check that exactly one argument (the top-level folder) is provided.
if [ $# -ne 1 ]; then
    echo "Usage: $0 <top-folder>" >&2
    exit 1
fi

top="$1"

# Verify that the provided folder exists.
if [ ! -d "$top" ]; then
    echo "Error: '$top' does not exist or is not a directory." >&2
    exit 1
fi

# Generate professor-to-course mapping files.
for track in "" "cti/" "is/"; do
    ./prof_course.py \
        "$top/summary/${track}prof_courses.csv" \
        > "$top/mapping/${track}prof_courses.csv"
done

# Count the number of students enrolled in each course.
./num_students_per_course \
    "$top/user/json/" \
    "$top/mapping/"

# Generate a mapping from user IDs to email addresses.
./person_email "$top/user/json/" \
    > "$top/mapping/user_email.csv"

# Match feedback records to their corresponding courses.
for track in "" "cti/" "is/"; do
    ./feedback_course_mapping.py \
        "$top/summary/${track}raw.csv" \
        "$top/mapping/${track}num_users.csv" \
        "$top/mapping/prof_courses.csv" \
        > "$top/mapping/${track}num_feedbacks/raw.csv"
done

# Generate the complete feedback mappings.
for track in "" "cti/" "is/"; do
    ./full_feedback_course_mapping.py \
        "$top/summary/${track}raw.csv" \
        "$top/mapping/${track}num_users.csv" \
        > "$top/mapping/${track}num_feedbacks/all.csv"
done

echo "Mapping generation completed successfully."
