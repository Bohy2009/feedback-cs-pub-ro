#!/bin/bash

# Check that the input directory was provided.
if [ $# -ne 1 ]; then
    echo "Usage: $0 <folder with .json files>" >&2
    exit 1
fi

in="$1"

# Verify that the input directory exists.
if [ ! -d "$in" ]; then
    echo "Error: Folder $in does not exist or is not a directory." >&2
    exit 1
fi

# Extract username, full name, and email from every JSON file.
IFS=$'\n'
for i in "$in"/*.json; do
    jq -r '.[] | [.username, .fullname, .email] | @csv' "$i"
done | sort -u
